# =============================================================================
# Verdikt — backend configuration example
# Copy to .env and adjust for your environment.
# =============================================================================
# Nested config keys use double-underscore: VERDIKT_INFERENCE__OLLAMA_BASE_URL


# -----------------------------------------------------------------------------
# Data directories
# -----------------------------------------------------------------------------

# System data root: auth.db, jwt_secret, logs, HuggingFace model cache
VERDIKT_DATA_DIR=/var/lib/verdikt

# Per-user data root: verdikt.db (SQLCipher), chroma/, files/ per user
# Can point to a separate volume from DATA_DIR
VERDIKT_USERS_DIR=/var/lib/verdikt/users


# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------

# JWT signing secret. If unset, auto-generated and persisted to DATA_DIR/jwt_secret
# VERDIKT_JWT_SECRET=change-me-to-a-long-random-string

# ASGI subpath prefix when running behind a reverse proxy at a non-root path
# VERDIKT_ROOT_PATH=/verdikt

# Allowed CORS origins (comma-separated). Only needed for separate frontend origins.
# VERDIKT_CORS_ORIGINS=http://localhost:5173

# Path to built frontend dist/ folder. When set, FastAPI serves the SPA as a catch-all.
# (Set automatically in the Docker image; not needed for local dev with Vite.)
# VERDIKT_FRONTEND_DIR=/app/frontend/dist


# -----------------------------------------------------------------------------
# Inference — Ollama
# -----------------------------------------------------------------------------

# VERDIKT_INFERENCE__OLLAMA_BASE_URL=http://localhost:11434
# VERDIKT_INFERENCE__OLLAMA_MODEL=llama3.1:8b
# VERDIKT_INFERENCE__OLLAMA_TIMEOUT=300.0


# -----------------------------------------------------------------------------
# Inference — embedding models
# -----------------------------------------------------------------------------

# sentence-transformers model for text embeddings (runs locally, no Ollama needed)
# VERDIKT_INFERENCE__EMBEDDING_MODEL=all-MiniLM-L6-v2

# HuggingFace CLIP model for image embeddings
# VERDIKT_INFERENCE__CLIP_MODEL=openai/clip-vit-base-patch32


# -----------------------------------------------------------------------------
# AI preview in rating interface
# -----------------------------------------------------------------------------

# Show AI score preview after submitting a rating (text domain)
# VERDIKT_AI_PREVIEW_TEXT=true

# Show AI score preview after submitting a rating (image domain — off by default, slower)
# VERDIKT_AI_PREVIEW_IMAGE=false


# -----------------------------------------------------------------------------
# Project defaults (used when creating a new project)
# -----------------------------------------------------------------------------

# VERDIKT_DEFAULT_CRYSTALLISATION_THRESHOLD=10
# VERDIKT_DEFAULT_CHUNK_MIN_SIZE=600
# VERDIKT_DEFAULT_CHUNK_MAX_SIZE=800

# Hard bounds for chunk size inputs in the UI
# VERDIKT_CHUNK_SIZE_MIN_LOWER=0
# VERDIKT_CHUNK_SIZE_MAX_UPPER=1000


# -----------------------------------------------------------------------------
# SMTP (email confirmation)
# Leave all unset to disable email sending (confirmation links printed to logs instead)
# -----------------------------------------------------------------------------

# VERDIKT_SMTP_HOST=smtp.example.com
# VERDIKT_SMTP_PORT=587
# VERDIKT_SMTP_USER=user@example.com
# VERDIKT_SMTP_PASSWORD=
# VERDIKT_SMTP_FROM=verdikt@example.com
# VERDIKT_SMTP_USE_TLS=true


# -----------------------------------------------------------------------------
# OAuth — Google
# Leave unset to disable Google login
# -----------------------------------------------------------------------------

# VERDIKT_GOOGLE_CLIENT_ID=
# VERDIKT_GOOGLE_CLIENT_SECRET=
# VERDIKT_OAUTH_REDIRECT_BASE=https://verdikt.example.com


# -----------------------------------------------------------------------------
# OAuth — GitHub
# Leave unset to disable GitHub login
# (VERDIKT_OAUTH_REDIRECT_BASE shared with Google above)
# -----------------------------------------------------------------------------

# VERDIKT_GITHUB_CLIENT_ID=
# VERDIKT_GITHUB_CLIENT_SECRET=


# -----------------------------------------------------------------------------
# Plugin — AO3 sampling
# Two-stage Gaussian paragraph sampling to avoid fetching entire works
# AO3 is a community resource — do not lower the request delay below 3.0
# -----------------------------------------------------------------------------

# VERDIKT_AO3_SAMPLE_RATE=0.10
# VERDIKT_AO3_SAMPLE_STDDEV=1.5
# VERDIKT_AO3_REQUEST_DELAY=5.0


# -----------------------------------------------------------------------------
# Plugin — Royal Road sampling
# Two-stage Gaussian: chapter selection then paragraph sampling within chapters
# -----------------------------------------------------------------------------

# VERDIKT_RR_REQUEST_DELAY=2.0
# VERDIKT_RR_CHAPTER_RATE=0.30
# VERDIKT_RR_CHAPTER_STDDEV=1.5
# VERDIKT_RR_SAMPLE_RATE=0.20
# VERDIKT_RR_SAMPLE_STDDEV=1.5
