<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>Verdikt</title>
    <options customize="never" rootVolumeOnly="false"/>
    <allowed-os-versions>
        <os-version min="12.0"/>
    </allowed-os-versions>
    <choices-outline>
        <line choice="com.verdikt.app"/>
    </choices-outline>
